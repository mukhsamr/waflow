{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "waflow-api",
  "main": "src/index.ts",
  "alias": {
    "ws": "./src/ws-worker.ts"
  },
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "ADMIN_EMAIL",
      "ADMIN_NAME",
      "ADMIN_PASSWORD",
      "SESSION_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMIT",
      "namespace_id": "731042",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WA_SESSIONS",
        "class_name": "WaSession"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waflow-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WaSession"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "waflow-outgoing",
        "binding": "OUTGOING_QUEUE"
      },
      {
        "queue": "waflow-incoming",
        "binding": "INCOMING_QUEUE"
      }
    ],
    "consumers": [
      {
        "dead_letter_queue": "waflow-outgoing-failed",
        "max_batch_timeout": 1,
        "queue": "waflow-outgoing",
        "max_batch_size": 10,
        "max_retries": 5
      },
      {
        "dead_letter_queue": "waflow-incoming-failed",
        "max_batch_timeout": 1,
        "queue": "waflow-incoming",
        "max_batch_size": 20,
        "max_retries": 5
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
